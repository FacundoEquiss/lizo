{
  "name": "telar",
  "version": "0.3.0",
  "description": "Lienzo infinito + kanban para ordenar proyectos, manejable por IA vía MCP.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n servidor,web -c magenta,cyan \"npm:dev:servidor\" \"npm:dev:web\"",
    "dev:servidor": "tsx watch --clear-screen=false servidor/src/principal.ts --dev",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx servidor/src/principal.ts --produccion",
    "mcp": "tsx servidor/src/mcp/stdio.ts",
    "importar:discord": "tsx servidor/src/importar/discord.ts",
    "guia": "tsx scripts/guia-para-ias.ts",
    "oauth:probar": "node scripts/probar-oauth.mjs",
    "cuentas:probar": "node scripts/probar-cuentas.mjs",
    "amigos:probar": "tsx servidor/src/amigos.prueba.ts",
    "recuperacion:probar": "tsx servidor/src/recuperacion.prueba.ts",
    "solicitudes:probar": "tsx servidor/src/solicitudes.prueba.ts",
    "hecho:probar": "tsx servidor/src/dominio/archivo-hecho.prueba.ts",
    "vistas:probar": "tsx servidor/src/dominio/vistas.prueba.ts",
    "tabla:probar": "tsx compartido/tabla.prueba.ts",
    "menciones:probar": "tsx compartido/menciones.prueba.ts",
    "ia:probar": "node scripts/probar-ia.mjs",
    "ia:probar-migracion": "tsx servidor/src/ia/migracion.prueba.ts",
    "ia:probar-boveda": "tsx servidor/src/ia/boveda.prueba.ts",
    "ia:probar-agentes": "tsx servidor/src/ia/agentes.prueba.ts",
    "ia:probar-codigo": "tsx servidor/src/ia/codigo.prueba.ts",
    "ia:probar-codigo-real": "tsx scripts/probar-ia-codigo-real.ts",
    "ia:probar-precios": "tsx --test servidor/src/ia/proveedores/precios.prueba.ts",
    "ia:probar-contratos": "tsx --test servidor/src/ia/proveedores/contratos.prueba.ts servidor/src/ia/proveedores/anthropic.prueba.ts servidor/src/ia/proveedores/falso.prueba.ts",
    "ia:probar-real": "node scripts/probar-ia-real.mjs",
    "ia:probar-real-simulado": "node scripts/probar-ia-real.mjs --simulado",
    "ia:probar-contratos-b2": "tsx --test servidor/src/ia/proveedores/contratos-b2.prueba.ts",
    "ia:probar-tanda": "tsx servidor/src/dominio/tanda.prueba.ts",
    "ia:probar-herramientas": "tsx servidor/src/ia/herramientas-agente.prueba.ts",
    "ia:probar-contexto": "tsx servidor/src/ia/contexto.prueba.ts",
    "ia:probar-segundo-plano": "tsx servidor/src/ia/segundo-plano.prueba.ts",
    "ia:probar-direcciones": "tsx servidor/src/ia/direcciones.prueba.ts",
    "ia:probar-ejecutor": "tsx servidor/src/ia/ejecutor.prueba.ts",
    "ia:probar-menciones-ia": "tsx servidor/src/ia/menciones-ia.prueba.ts",
    "ia:probar-rutas": "tsx servidor/src/ia/rutas-ia.prueba.ts",
    "ia:probar-servidor": "npm run ia:probar-tanda && npm run ia:probar-herramientas && npm run ia:probar-contexto && npm run ia:probar-direcciones && npm run ia:probar-segundo-plano && npm run ia:probar-ejecutor && npm run ia:probar-menciones-ia && npm run ia:probar-rutas",
    "menciones:levantar": "node scripts/levantar-menciones.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "postinstall": "vite build --logLevel error || echo \"(la web se compila con npm run build)\"",
    "build:vercel": "vite build && node scripts/vercel.mjs",
    "pwa:iconos": "node scripts/iconos-pwa.mjs",
    "pwa:verificar": "node scripts/iconos-pwa.mjs --verificar",
    "pwa:revisar": "node scripts/revisar-pwa.mjs",
    "diseno:importar": "tsx scripts/diseno/importar.ts",
    "diseno:probar-mcp": "node scripts/diseno/prueba-mcp.mjs",
    "diseno:probar-sanear": "tsx servidor/src/diseno/sanear.prueba.ts",
    "diseno:sembrar": "node scripts/diseno/sembrar.mjs",
    "diseno:ver": "node scripts/diseno/ver.mjs",
    "diseno:capturas": "node scripts/diseno/capturas.mjs",
    "ia:probar-produccion": "tsx servidor/src/ia/produccion.prueba.ts",
    "ia:probar-proveedores": "tsx --test servidor/src/ia/proveedores/precios.prueba.ts servidor/src/ia/proveedores/contratos.prueba.ts servidor/src/ia/proveedores/anthropic.prueba.ts servidor/src/ia/proveedores/falso.prueba.ts servidor/src/ia/proveedores/contratos-b2.prueba.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.14.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electric-sql/pglite": "0.6.0",
    "@floating-ui/react": "^0.27.20",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@hono/node-server": "^2.1.11",
    "@modelcontextprotocol/server": "2.4.0",
    "@sparticuz/chromium": "^153.0.0",
    "@tiptap/core": "^3.35.0",
    "@tiptap/extension-list": "^3.35.0",
    "@tiptap/extensions": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/react": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "@vercel/functions": "3.11.3",
    "@xyflow/react": "13.0.3",
    "cmdk": "^1.1.1",
    "dompurify": "^3.5.0",
    "fractional-indexing": "^4.0.0",
    "hono": "^4.13.21",
    "lucide-react": "^1.78.0",
    "markdown-it": "^15.0.3",
    "motion": "^14.14.0",
    "nanoid": "^6.0.2",
    "parse5": "^8.1.1",
    "pg": "^8.23.1",
    "playwright-core": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tinykeys": "^4.0.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "postcss": "^8.5.33",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "license": "AGPL-3.0-only"
}
